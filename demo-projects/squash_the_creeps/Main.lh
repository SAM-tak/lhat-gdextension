# The game, in L^. The GDScript this replaces was Main.gd.

module^squash.main

import^godot

@game @export_class
public^let^Main = def^{
	self^{
		abstract^gdobj : godot.Node,
		@node("DirectionalLight3D") abstract^light : godot.DirectionalLight3D,
		@node("Player") abstract^player : godot.CharacterBody3D,
		@node("MobTimer") abstract^mobTimer : godot.Timer,
		@node("SpawnPath/SpawnLocation") abstract^spawn : godot.PathFollow3D,
		@node("UserInterface/Retry") abstract^retry : godot.ColorRect,
		@node("UserInterface/ScoreLabel") abstract^scoreLabel : godot.Label,

		# Named as the scene names it, so Main.tscn's `mob_scene =` line goes
		# on meaning this field.
		@export mob_scene : godot.PackedScene|nil^ = nil^,
	},

	override^new = f^obj { self^{ gdobj = obj } },

	delegate^self^.gdobj,

	_ready = p^self^{
		if^godot.RenderingServer.get_current_rendering_method() = "gl_compatibility" {
			# PCF13 shadow filtering, which reads better than the medium
			# setting's PCF5.
			# TODO: RenderingServer.SHADOW_QUALITY_SOFT_HIGH is 4.
			godot.RenderingServer.directional_soft_shadow_filter_set_quality(4)

			# The light's energy is darkened to make up for sRGB blending,
			# without touching how the sky is drawn.
			# TODO: the engine's enums have no spelling in L^ yet, so these
			# stand in for DirectionalLight3D.SKY_MODE_SKY_ONLY (2) and
			# SKY_MODE_LIGHT_ONLY (1), Light3D.PARAM_ENERGY (0), and the
			# duplicate flags Node.duplicate defaults to (15).
			self^.light.set_sky_mode(2)
			let^made = self^.light.duplicate(15)
			if^made fits^godot.DirectionalLight3D {
				made.set_param(0, 0.35)
				made.set_sky_mode(1)
				self^.add_child(made, false^, 0)
			}
		}

		self^.retry.hide()
	},

	_unhandled_input = p^self^, event:godot.InputEvent {
		if^event.is_action_pressed("ui_accept", false^, false^)
		   and^ self^.retry.is_visible() {
			self^.get_tree().reload_current_scene()
		}
	},

	_on_mob_timer_timeout = p^self^{
		let^scene = self^.mob_scene
		if^scene fits^nil^ { return^}
		let^mob = scene.instantiate(0)
		if^!(mob fits^godot.Node) { return^}

		# A random spot on the SpawnPath.
		self^.spawn.set_progress_ratio(godot.randf())

		# The spawn point and the player's place, told to the mob. 05 の 8.9
		# keeps a host value out of the any^ tail of a variadic call, so each
		# rides in the box its own type provides.
		mob.call("initialize", box^self^.spawn.get_position(),
		                      box^self^.player.get_position())

		self^.add_child(mob, false^, 0)

		# The mob is wired to the score label, which counts the squashing.
		godot.signal(mob, "squashed").connect(
			godot.callable(self^.scoreLabel, "_on_Mob_squashed"))
	},

	_on_player_hit = p^self^{
		self^.mobTimer.stop()
		self^.retry.show()
	},
}
