[configuration]

entry_symbol = "lhat_library_init"
compatibility_minimum = "4.5"

; The keys are feature tags, all of which have to hold (OS::has_feature), and
; the row with the MOST tags wins -- not the first one written. So the three
; runtimes are told apart by the tag that names each rather than by `debug`
; and `release`: `editor` holds only under TOOLS_ENABLED and `template_debug`
; and `template_release` only outside it (core/os/os.cpp), which makes the
; three disjoint. Writing `debug` here instead would match the editor as well
; as a debug export, with the same tag count, and which one won would be the
; order of the keys.
[libraries]

windows.editor.x86_64 = "res://bin/liblhat.windows.editor.x86_64.dll"
windows.template_debug.x86_64 = "res://bin/liblhat.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://bin/liblhat.windows.template_release.x86_64.dll"
windows.editor.arm64 = "res://bin/liblhat.windows.editor.arm64.dll"
windows.template_debug.arm64 = "res://bin/liblhat.windows.template_debug.arm64.dll"
windows.template_release.arm64 = "res://bin/liblhat.windows.template_release.arm64.dll"
linux.editor.x86_64 = "res://bin/liblhat.linux.editor.x86_64.so"
linux.template_debug.x86_64 = "res://bin/liblhat.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://bin/liblhat.linux.template_release.x86_64.so"
linux.editor.arm64 = "res://bin/liblhat.linux.editor.arm64.so"
linux.template_debug.arm64 = "res://bin/liblhat.linux.template_debug.arm64.so"
linux.template_release.arm64 = "res://bin/liblhat.linux.template_release.arm64.so"
macos.editor.x86_64 = "res://bin/liblhat.macos.editor.x86_64.dylib"
macos.template_debug.x86_64 = "res://bin/liblhat.macos.template_debug.x86_64.dylib"
macos.template_release.x86_64 = "res://bin/liblhat.macos.template_release.x86_64.dylib"
macos.editor.arm64 = "res://bin/liblhat.macos.editor.arm64.dylib"
macos.template_debug.arm64 = "res://bin/liblhat.macos.template_debug.arm64.dylib"
macos.template_release.arm64 = "res://bin/liblhat.macos.template_release.arm64.dylib"
