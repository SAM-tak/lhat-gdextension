[configuration]

entry_symbol = "lhat_library_init"
compatibility_minimum = "4.5"

; The keys are feature tags, all of which have to hold (OS::has_feature), and
; the row with the MOST tags wins -- not the first one written. So the three
; runtimes are told apart by the tag that names each rather than by `debug`
; and `release`: `editor` holds only under TOOLS_ENABLED and `template_debug`
; and `template_release` only outside it (core/os/os.cpp), which makes the
; three disjoint. Writing `debug` here instead would match the editor as well
; as a debug export, with the same tag count, and which one won would be the
; order of the keys.
;
; The plain template rows name the VM-only libraries (LHAT_VM_ONLY): an
; export carries compiled units unless lhat/script_export_mode says Text, and
; then the L^ export plugin ships the library with the front end as well and
; raises `lhat_text` on the game, so the row with that tag -- one more than
; the plain row -- wins (src/lhat_export.cpp). The editor reads text and has
; no VM-only row; a game run from the editor is the editor.
;
; Only what is built is listed. A row whose file is not there is a load that
; fails on that machine, so the desktops this is released for are here and
; nothing else: x86_64 on Windows and Linux, and one universal library on
; macOS, which both architectures there answer to (`universal` is true for
; x86_64 and for arm64 alike, core/os/os.cpp). Android, iOS and the web are
; other tags again, and other toolchains -- iOS wants a static library rather
; than a shared one.
[libraries]

windows.editor.x86_64 = "res://bin/liblhat.windows.editor.x86_64.dll"
windows.template_debug.x86_64 = "res://bin/liblhat.windows.template_debug.vmonly.x86_64.dll"
windows.template_release.x86_64 = "res://bin/liblhat.windows.template_release.vmonly.x86_64.dll"
windows.template_debug.lhat_text.x86_64 = "res://bin/liblhat.windows.template_debug.x86_64.dll"
windows.template_release.lhat_text.x86_64 = "res://bin/liblhat.windows.template_release.x86_64.dll"

linux.editor.x86_64 = "res://bin/liblhat.linux.editor.x86_64.so"
linux.template_debug.x86_64 = "res://bin/liblhat.linux.template_debug.vmonly.x86_64.so"
linux.template_release.x86_64 = "res://bin/liblhat.linux.template_release.vmonly.x86_64.so"
linux.template_debug.lhat_text.x86_64 = "res://bin/liblhat.linux.template_debug.x86_64.so"
linux.template_release.lhat_text.x86_64 = "res://bin/liblhat.linux.template_release.x86_64.so"

macos.editor.universal = "res://bin/liblhat.macos.editor.universal.dylib"
macos.template_debug.universal = "res://bin/liblhat.macos.template_debug.vmonly.universal.dylib"
macos.template_release.universal = "res://bin/liblhat.macos.template_release.vmonly.universal.dylib"
macos.template_debug.lhat_text.universal = "res://bin/liblhat.macos.template_debug.universal.dylib"
macos.template_release.lhat_text.universal = "res://bin/liblhat.macos.template_release.universal.dylib"
