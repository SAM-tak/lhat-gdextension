# A script a node wears. 05 の 8.8改 puts the engine's tree on the host side,
# so godot.Sprite2D is a type the checker knows: what says this is a Sprite2D
# is the handle's own type, and delegate^ (02 の 14.7改2) is what shows that
# class's members -- everything Node2D, Node and Object declare included --
# without a forwarding member for any of them.

module^demo.spinner

import^godot

# くるくる回る
#
# 横滑りしながらくるくる回るだけ
@game @export_class
public^let^Spinner = def^{
	self^{
		abstract^gdobj : godot.Sprite2D,

		# 回転速度
		@export_range(0, 10) speed = 1,
		# スライド速度
		@export_range(0, 5000) slideSpeed = 500,
		turns = 0,
	},

	override^new = f^obj:godot.Sprite2D {
		self^{ gdobj = obj }
	},

	# 02 の 18: what the engine registers this class as.
	gdBaseClass = "Sprite2D",

	delegate^self^.gdobj,

	@signal died = p^self^, message:string^{}, # 空なら勝手に埋めてくれる

	_ready = p^self^{
		print($"spinner on a {self^.className()}, named {self^.get_name()}")
	},

	_process = p^self^, delta:number^{
		let^world = self^.get_global_transform()
		let^xAxis = world.x() # ワールドの X 軸
		self^.set_position(self^.get_position() + xAxis * delta * self^.slideSpeed)
		self^.set_rotation(self^.get_rotation() + delta * self^.speed)
		self^.turns += 1
		if^self^.turns = 10 {
			self^.died("死にました")
		}
	},

	on_timeout = p^self^{ self^.turns += 100 },

	report = f^self^ -> string^{$"{self^.turns} frames, rotation {self^.get_rotation()}"},

	_on_script_changed = p^self^ {
		print("script changed")
	},

	_on_died = p^self^, message:any^ {
		print(id^_on_died, message)
	},
}
